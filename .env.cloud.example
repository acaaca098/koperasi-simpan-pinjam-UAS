# Tambahan konfigurasi .env untuk memenuhi konsep cloud computing (Bagian 5.3):
# object storage terpisah untuk file upload (jaminan pinjaman, bukti transfer).
# Bisa pakai AWS S3, Cloudflare R2, atau DigitalOcean Spaces (semuanya S3-compatible).
# JANGAN commit file .env asli ke Git — ini cuma contoh/template.

FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=isi_dari_provider_kamu
AWS_SECRET_ACCESS_KEY=isi_dari_provider_kamu
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=koperasi-simpan-pinjam-uploads
AWS_USE_PATH_STYLE_ENDPOINT=false
# Kalau pakai R2/Spaces, isi juga AWS_ENDPOINT sesuai provider

# Managed database (contoh Railway/PlanetScale/RDS) - JANGAN pakai MySQL
# yang di-install manual di server sendiri.
DB_CONNECTION=mysql
DB_HOST=isi_host_managed_db
DB_PORT=3306
DB_DATABASE=koperasi
DB_USERNAME=isi_dari_provider
DB_PASSWORD=isi_dari_provider

MAIL_MAILER=smtp
MAIL_HOST=isi_smtp_provider
MAIL_PORT=587
MAIL_USERNAME=isi_dari_provider
MAIL_PASSWORD=isi_dari_provider
